# Stream URL (raw AAC/MP3 stream or HLS m3u8)
STREAM_URL=https://live1.sr.se/knattekanalen-aac-320

# Source timezone (where the stream originates)
SOURCE_TIMEZONE=Europe/Stockholm

# Storage path on host (docker will write here)
DATA_PATH=/path/to/rshift/data

# HTTP server
PORT=8080

# Local timezone is auto-detected from host via /etc/localtime
